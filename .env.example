# ZERO-COST DEFAULTS — no paid API keys required.
DATABASE_PATH=./data/jobs.db
POLL_SECONDS=1800
MIN_SCORE=55
MAX_JOB_AGE_DAYS=14

# Optional local model. Leave disabled to use deterministic ranking only.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Never auto-submit applications in v1.
AUTO_SUBMIT=false
